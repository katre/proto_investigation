load("@grpc-java//:java_grpc_library.bzl", "java_grpc_library")
load("@protobuf//bazel:java_proto_library.bzl", "java_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_java//java:java_binary.bzl", "java_binary")

proto_library(
    name = "greeter_proto",
    srcs = ["greeter.proto"],
)

java_proto_library(
    name = "greeter_java_proto",
    deps = [":greeter_proto"],
)

java_grpc_library(
    name = "greeter_java_grpc",
    srcs = [":greeter_proto"],
    deps = [":greeter_java_proto"],
)

java_binary(
    name = "greeter_java_bin",
    srcs = ["com/example/greeter/Main.java"],
    main_class = "com.example.greeter.Main",
    deps = [
        ":greeter_java_grpc",
        ":greeter_java_proto",
        "@grpc-java//api",
        "@grpc-java//stub",
    ],
)
