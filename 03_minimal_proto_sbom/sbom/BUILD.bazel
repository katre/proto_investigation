load("@supply_chain_tools//sbom:cyclonedx.bzl", "cyclonedx")
load("@supply_chain_tools//sbom:sbom.bzl", "sbom")
load("@supply_chain_tools//sbom:spdx.bzl", "spdx")

# One sbom + cyclonedx + spdx triple per target in //proto.

sbom(
    name = "greeting_proto_sbom",
    require_root_metadata = False,
    target = "//proto:greeting_proto",
)

cyclonedx(
    name = "greeting_proto_cyclonedx",
    sbom = ":greeting_proto_sbom",
)

spdx(
    name = "greeting_proto_spdx",
    sbom = ":greeting_proto_sbom",
)

