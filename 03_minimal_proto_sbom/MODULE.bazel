module(name = "minimal_proto_sbom")

bazel_dep(name = "protobuf", version = "37.0-rc1")

# Needed to load cc_binary/java_binary. Versions match what protobuf already
# resolves to, so these don't change the module graph.
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_java", version = "9.3.0")

# SBOM generation from bazel-contrib/supply-chain. The BCR only has
# supply_chain_tools 0.0.1, so all of the repo's modules are pinned to the
# same commit of main (2026-10-23).
SUPPLY_CHAIN_COMMIT = "df3e61f82ee285763f3ed5cbfc0fab1fedd976ec"

bazel_dep(name = "supply_chain_tools")
git_override(
    module_name = "supply_chain_tools",
    commit = SUPPLY_CHAIN_COMMIT,
    remote = "https://github.com/bazel-contrib/supply-chain.git",
    strip_prefix = "tools",
)

bazel_dep(name = "package_metadata")
git_override(
    module_name = "package_metadata",
    commit = SUPPLY_CHAIN_COMMIT,
    remote = "https://github.com/bazel-contrib/supply-chain.git",
    strip_prefix = "metadata",
)

bazel_dep(name = "supply-chain-go")
git_override(
    module_name = "supply-chain-go",
    commit = SUPPLY_CHAIN_COMMIT,
    remote = "https://github.com/bazel-contrib/supply-chain.git",
    strip_prefix = "lib/supplychain-go",
)
